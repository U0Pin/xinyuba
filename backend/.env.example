OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
GATING_MODEL_NAME=qwen-turbo
TEMPERATURE=0.7
MAX_TOKENS=4096

# ── 新架构参数（可选，均有默认值） ──────────────────────────────
# 决策线廉价模型（安全决策等）
CHEAP_MODEL_NAME=qwen-turbo
# 疗法决策滑动窗口大小（轮）
WINDOW_SIZE=5
# 疗法决策 token 触发阈值（估算口径：字符数/2）；0 = 每条消息都评估（默认）
# 注意：阈值只决定评估频率；是否触发疗法由决策器按信号判断（闲聊不会触发）
WINDOW_TOKEN_THRESHOLD=0
# 疗程工作轮数上限
THERAPY_MAX_ROUNDS=10
# 对话线读取的近 N 轮窗口
RECENT_TURNS=3
# 会话摘要重生成 token 阈值（估算口径：字符数/2）
SUMMARY_TOKEN_THRESHOLD=1500
