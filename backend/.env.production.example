# ── 生产环境变量模板 ────────────────────────────────────────────────
# 用法：复制为 .env（不入库！），填入真实值后由 docker compose 加载。
#   cp .env.production.example .env
# 敏感项（API Key / 私钥）绝不能提交到仓库。

# ── LLM 服务（必填）────────────────────────────────────────────────
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
# 决策线廉价模型（安全决策等）
CHEAP_MODEL_NAME=qwen-turbo
# 兼容旧字段名
GATING_MODEL_NAME=qwen-turbo
TEMPERATURE=0.7
MAX_TOKENS=4096

# ── 新架构参数（可选，均有默认值）──────────────────────────────────
# 疗法决策滑动窗口大小（轮）
WINDOW_SIZE=5
# 疗法决策 token 触发阈值（估算口径：字符数/2）
#   0 = 每条消息都评估（开发/测试期，决策最灵敏）
#   生产建议调大以降低决策器调用成本，例如 2000（约 4000 字用户输入才评估一次）
WINDOW_TOKEN_THRESHOLD=2000
# 疗程工作轮数上限
THERAPY_MAX_ROUNDS=10
# 对话线读取的近 N 轮窗口
RECENT_TURNS=3
# 会话摘要重生成 token 阈值（估算口径：字符数/2）
#   0 = 每次有新增流水都重生成（开发/测试期）
#   生产建议调大，例如 3000
SUMMARY_TOKEN_THRESHOLD=3000

# ── 存盘与日志（容器内路径；compose 已挂载到宿主机）────────────────
# DATA_ROOT=/app/data
# LOG_DIR=/app/logs